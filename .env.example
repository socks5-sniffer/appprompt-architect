# Copy this file to .env and fill in your keys.
# The server reads these at startup - keys are NEVER sent to the browser.

# Google Gemini API key (required to use Gemini provider)
GEMINI_API_KEY=

# Anthropic Claude API key (required to use Claude provider)
ANTHROPIC_API_KEY=

# OpenAI API key (required to use OpenAI provider)
OPENAI_API_KEY=

# Port for the backend API server (default: 3001)
PORT=3001

# Frontend origin for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Optional model overrides — uncomment to pin a specific model per provider.
# Defaults shown below.
# GEMINI_MODEL=gemini-3.6-flash
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.6-terra

# Optional per-IP rate limit for /api/* (defaults: 30 requests / 15 min window).
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=900000

# Optional shared secret required on /api/* requests via the `x-api-secret` header.
# Leave unset for local dev. Set this if the server is reachable beyond localhost.
# API_SHARED_SECRET=

# Must match API_SHARED_SECRET above — read by the frontend build (Vite only exposes
# VITE_-prefixed vars to client code) so it can send the header. Leave unset with the above.
# VITE_API_SHARED_SECRET=
